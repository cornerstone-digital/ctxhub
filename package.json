{
  "name": "ctxhub",
  "version": "0.1.0",
  "description": "Reusable developer workspace CLI for multi-repo indexing and AI agent memory/MCP workflows.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ctxhub": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "ctxhub.example.yaml"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "ctxhub": "tsx src/index.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "react": "^19.2.7",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "semantic-release": "^25.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.63.0"
  }
}
